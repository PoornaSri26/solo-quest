# ============================================================
# Solo Quest — server environment template (#460)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Core ---
# SQLite for dev; use the PostgreSQL schema + URL for production
DATABASE_URL="file:./dev.db"
# Min 16 chars (validated at boot by src/env.ts)
JWT_SECRET="change-this-to-a-random-secret-key"
PORT=5000
# development | production | test
NODE_ENV="development"
# error | warn | info | debug
LOG_LEVEL="info"

# --- Redis (optional) ---
# When unset, rate limiters, cache and job queues fall back to in-memory mode
REDIS_URL="redis://localhost:6379"

# --- CORS / CSP / CSRF shared allowlist (comma-separated) ---
# Single source of truth for all three origin checks (see src/env.ts).
# localhost entries are always allowed for development.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5000"

# --- Stripe (optional; payments disabled when unset) ---
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# --- Frontend origin (CORS default) ---
FRONTEND_URL="http://localhost:5173"

# --- Superadmin seed (npm run prisma:seed:admin) ---
# The script refuses to run in production with the default password
SUPERADMIN_EMAIL="admin@soloquest.app"
SUPERADMIN_PASSWORD="ChangeMe!2026"
SUPERADMIN_NAME="Platform Admin"
