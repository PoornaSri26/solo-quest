datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  hunterId      String   @unique
  displayName   String
  email         String   @unique
  passwordHash  String
  avatarUrl     String?
  createdAt     DateTime @default(now())
  hunterStats   HunterStats? @relation("HunterStats")
  quests        Quest[]  @relation("UserQuests")
  gates         Gate[]   @relation("UserGates")
  dailyDungeons DailyDungeon[] @relation("UserDungeons")
  notifications Notification[] @relation("UserNotifications")
  inventory     UserInventory[] @relation("UserInventory")
  questDecisions QuestDecision[] @relation("UserQuestDecisions")
  resourceUsage ResourceUsage[] @relation("UserResourceUsage")
  knowledge     KnowledgeProgress? @relation("UserKnowledge")
  socialStats   SocialStats? @relation("UserSocialStats")
  subscription  Subscription? @relation("UserSubscription")
  payments      Payment[] @relation("UserPayments")
  userSettings  UserSettings? @relation("UserSettings")
}

model HunterStats {
  id               String   @id @default(uuid())
  userId           String   @unique @map("fk_user_id")
  level            Int      @default(1)
  exp              Int      @default(0)
  expToNext        Int      @default(100)
  progressPercent  Float    @default(0)
  rank             String     @default("E")
  hp               Int      @default(100)
  hpMax            Int      @default(100)
  gold             Int      @default(0)
  streak           Int      @default(0)
  longestStreak    Int      @default(0)
  streakWards     Int      @default(1)
  streakWagerActive Boolean @default(false)
  streakWagerGoal  Int      @default(0)
  streakWagerStake Int      @default(0)
  streakWagerStart DateTime?
  statStrength     Int      @default(0)
  statAgility      Int      @default(0)
  statIntelligence Int      @default(0)
  statEndurance    Int      @default(0)
  statLuck         Int      @default(0)
  lastActiveDate   DateTime @default(now())
  user             User     @relation("HunterStats", fields: [userId], references: [id])
  milestoneProgress MilestoneProgress[] @relation("UserMilestoneProgress")
  masteryChallengeProgress MasteryChallengeProgress[] @relation("UserMasteryChallengeProgress")
  userMementos     UserMemento[] @relation("HunterStatsUserMementos")
}

model Quest {
  id           String   @id @default(uuid())
  userId       String   @map("fk_user_id")
  title        String
  rank         String
  category     String
  status       String   @default("SHADOW")
  deadline     DateTime?
  notes        String?
  gateId       String?    @map("fk_gate_id")
  isBossQuest  Boolean    @default(false)
  expReward    Int
  goldReward   Int
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subtasks     QuestSubtask[] @relation("QuestSubtasks")
  gate         Gate?      @relation("QuestGate", fields: [gateId], references: [id])
  user         User       @relation("UserQuests", fields: [userId], references: [id])
  decisions    QuestDecision[] @relation("QuestDecisions")

  @@index([userId, status])
  @@index([userId, gateId])
  @@index([userId, completedAt])
}

model QuestSubtask {
  id        String   @id @default(uuid())
  questId   String   @map("fk_quest_id")
  title     String
  completed Boolean  @default(false)
  position  Int
  quest     Quest    @relation("QuestSubtasks", fields: [questId], references: [id])
}

model Gate {
  id        String   @id @default(uuid())
  userId    String   @map("fk_user_id")
  name      String
  rank      String
  deadline  DateTime?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  user      User     @relation("UserGates", fields: [userId], references: [id])
  quests    Quest[]  @relation("QuestGate")

  @@index([userId, status])
  @@index([userId, createdAt])
}

model DailyDungeon {
  id        String   @id @default(uuid())
  userId    String   @map("fk_user_id")
  name      String
  shift     String?   @default("ALL_DAY")
  active    Boolean  @default(true)
  tasks     DungeonTask[] @relation("DungeonTasks")
  logs      DungeonLog[] @relation("DungeonLogs")
  user      User     @relation("UserDungeons", fields: [userId], references: [id])
}

model DungeonTask {
  id        String   @id @default(uuid())
  dungeonId String   @map("fk_dungeon_id")
  title     String
  rank      String
  position  Int
  completed Boolean  @default(false)
  dungeon   DailyDungeon @relation("DungeonTasks", fields: [dungeonId], references: [id])
}

model DungeonLog {
  id            String   @id @default(uuid())
  dungeonId     String   @map("fk_dungeon_id")
  date          DateTime @default(now())
  completedCount Int
  totalCount    Int
  cleared       Boolean
  dungeon       DailyDungeon @relation("DungeonLogs", fields: [dungeonId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("fk_user_id")
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

model ShopItem {
  id        String   @id @default(uuid())
  name      String
  category  String
  costGold  Int
  description String?
  userInventory UserInventory[] @relation("Item")
}

model UserInventory {
  id        String   @id @default(uuid())
  userId    String   @map("fk_user_id")
  itemId    String   @map("fk_item_id")
  equipped  Boolean  @default(false)
  acquiredAt DateTime @default(now())
  user      User     @relation("UserInventory", fields: [userId], references: [id])
  item      ShopItem @relation("Item", fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model Milestone {
  id          String   @id @default(uuid())
  name        String
  description String
  requirement String
  xpReward    Int
  goldReward  Int
  mementoId   String?  @map("fk_memento_id")
  memento     Memento? @relation("MilestoneMementos", fields: [mementoId], references: [id])
  progress    MilestoneProgress[] @relation("MilestoneProgress")
}

model MilestoneProgress {
  id          String   @id @default(uuid())
  userId      String   @map("fk_user_id")
  milestoneId String   @map("fk_milestone_id")
  completed   Boolean  @default(false)
  completedAt DateTime?
  progress    Int      @default(0)
  milestone   Milestone   @relation("MilestoneProgress", fields: [milestoneId], references: [id])
  stats       HunterStats @relation("UserMilestoneProgress", fields: [userId], references: [id])

  @@unique([userId, milestoneId], name: "userId_milestoneId")
  @@index([userId])
  @@index([milestoneId])
}

model MasteryChallenge {
  id          String   @id @default(uuid())
  name        String
  description String
  requirement String
  xpReward    Int
  goldReward  Int
  difficulty  String
  progress    MasteryChallengeProgress[] @relation("MasteryChallengeProgress")
}

model MasteryChallengeProgress {
  id          String   @id @default(uuid())
  userId      String   @map("fk_user_id")
  challengeId String   @map("fk_challenge_id")
  completed   Boolean  @default(false)
  completedAt DateTime?
  attempts    Int      @default(0)
  bestScore   Int?
  challenge   MasteryChallenge @relation("MasteryChallengeProgress", fields: [challengeId], references: [id])
  stats       HunterStats @relation("UserMasteryChallengeProgress", fields: [userId], references: [id])

  @@unique([userId, challengeId])
}

model Memento {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String
  rarity      String
  category    String
  milestones Milestone[] @relation("MilestoneMementos")
  userMementos UserMemento[] @relation("UserMementos")
}

model UserMemento {
  id        String   @id @default(uuid())
  userId    String   @map("fk_user_id")
  mementoId String   @map("fk_memento_id")
  unlockedAt DateTime @default(now())
  memento   Memento   @relation("UserMementos", fields: [mementoId], references: [id])
  stats     HunterStats @relation("HunterStatsUserMementos", fields: [userId], references: [id])

  @@unique([userId, mementoId])
}

model QuestDecision {
  id          String   @id @default(uuid())
  userId      String   @map("fk_user_id")
  questId     String   @map("fk_quest_id")
  decisionType String
  choice      String
  timestamp   DateTime @default(now())
  user        User     @relation("UserQuestDecisions", fields: [userId], references: [id])
  quest       Quest    @relation("QuestDecisions", fields: [questId], references: [id])

  @@index([userId, timestamp])
  @@index([questId, timestamp])
}

model ResourceUsage {
  id          String   @id @default(uuid())
  userId      String   @map("fk_user_id")
  resourceType String
  amount      Int
  purpose     String
  timestamp   DateTime @default(now())
  user        User     @relation("UserResourceUsage", fields: [userId], references: [id])

  @@index([userId, resourceType, timestamp])
}

model KnowledgeProgress {
  id          String   @id @default(uuid())
  userId      String   @unique @map("fk_user_id")
  questPatternsLearned Int      @default(0)
  optimalRoutesDiscovered Int @default(0)
  shortcutsUnlocked Int      @default(0)
  efficiencyRating Float    @default(0.0)
  lastUpdated DateTime @default(now())
  user        User     @relation("UserKnowledge", fields: [userId], references: [id])
}

model SocialStats {
  id          String   @id @default(uuid())
  userId      String   @unique @map("fk_user_id")
  friendsAdded Int      @default(0)
  questsShared Int      @default(0)
  achievementsShared Int @default(0)
  leaderboardRank Int?
  socialScore Int      @default(0)
  lastUpdated DateTime @default(now())
  user        User     @relation("UserSocialStats", fields: [userId], references: [id])
}

// Subscription and Payment Models
model Subscription {
  id              String   @id @default(uuid())
  userId          String   @unique @map("fk_user_id")
  plan            String   // "free", "hunter_pass", "guild", "enterprise"
  status          String   // "active", "canceled", "past_due", "trialing"
  startDate       DateTime @default(now())
  endDate         DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  stripeCustomerId String?
  stripeSubscriptionId String?
  user            User     @relation("UserSubscription", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
}

model Payment {
  id              String   @id @default(uuid())
  userId          String   @map("fk_user_id")
  amount          Int      // in cents
  currency        String   @default("usd")
  status          String   // "pending", "completed", "failed", "refunded"
  paymentMethod   String   // "stripe", "paypal", "apple_pay", "google_pay"
  paymentIntentId String?
  metadata        String?  // JSON string for additional data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model UserSettings {
  id                String   @id @default(uuid())
  userId            String   @unique @map("fk_user_id")
  simpleMode        Boolean  @default(false) // Simple mode hides complex RPG features
  penaltySeverity   String   @default("forgiving") // "forgiving", "moderate", "hardcore"
  notificationPreference String @default("adaptive") // "adaptive", "aggressive", "minimal"
  timezone          String?
  locale            String   @default("en")
  user              User     @relation("UserSettings", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}